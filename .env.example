# UmbraTheater — copia in .env e adatta

FRONTEND_PORT=3000
BACKEND_PORT=8000
BIND=0.0.0.0

# Opzionale: navi in tempo reale (gratis su https://aisstream.io)
AIS_API_KEY=

# Opzionale: quota OpenSky autenticata
# https://opensky-network.org
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

CACHE_TTL_SECONDS=45
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
